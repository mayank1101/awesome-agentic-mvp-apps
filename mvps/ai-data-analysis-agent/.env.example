# Copy to `.env` and fill in. On Streamlit Community Cloud there is no `.env`:
# paste the same keys into the app's Secrets, and `streamlit_app.py` bridges them
# into the environment before the first settings read.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Groq API key. Free tier at https://console.groq.com. Every model call in this
# app goes here; without it the app shows a setup screen and does nothing.
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Groq model id. Free-tier ids get retired without notice, so verify against
# https://console.groq.com/docs/models if calls start returning "model not found".
# Use an INSTRUCT model, not a reasoning one -- reasoning tokens come out of the
# same budget as the visible reply, and these token caps are sized for an
# instruct model's short, direct JSON output.
MODEL_NAME=llama-3.3-70b-versatile

# Low because code generation should be consistent, not creative.
MODEL_TEMPERATURE=0.1

# Output caps, per call type.
MAX_TOKENS_CODE=1200
MAX_TOKENS_ANSWER=700

# Per-call timeout.
MODEL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Data intake
# ---------------------------------------------------------------------------

MAX_UPLOAD_BYTES=10485760

# Rows/columns kept after loading. A larger file is truncated with a notice
# rather than rejected.
MAX_ROWS=200000
MAX_COLUMNS=200

# Rows of the dataset shown to the model verbatim as a schema preview.
PREVIEW_ROWS=8

# Cap on any single cell's text when building that preview.
MAX_CELL_CHARS=200

# Cap on rows of a computed result shown to the user and fed back to the model.
MAX_OUTPUT_ROWS=50

# ---------------------------------------------------------------------------
# Question / code budgets
# ---------------------------------------------------------------------------

MAX_QUESTION_CHARS=500
MAX_CODE_CHARS=4000

# Wall-clock cap on executing one piece of generated code. Generated code runs
# on a daemon thread with a join timeout -- see app/services/sandbox.py for why
# this bounds how long the user waits, not how long the interpreter works.
CODE_TIMEOUT_SECONDS=10

# Whole-question ceiling, checked between steps.
RUN_DEADLINE_SECONDS=90

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Master switch for the heuristic prompt-injection scan over the question and
# the dataset's own sampled text cells.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding stops the run (true) or only logs (false).
BLOCK_FLAGGED_INPUT=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
