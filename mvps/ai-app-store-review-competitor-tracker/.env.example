# App Review Competitor Tracker — configuration
#
# Copy to `.env` and set the model key for whichever MODEL_PROVIDER you use. On
# Streamlit Community Cloud there is no `.env`: put the same names into
# Settings → Secrets, and `streamlit_app.py` copies them into the environment
# before anything reads them. A real environment variable always wins over a
# secrets entry.
#
# There is no search-provider key here, unlike this repo's other MVPs: app
# lookup and review fetching, on both the App Store and Google Play, are free,
# keyless, public endpoints. The only required credential is the model
# provider's key.

# --------------------------------------------------------------------------- #
# Model
# --------------------------------------------------------------------------- #

# openrouter | groq | openai | anthropic | ollama | gemini | foundry
MODEL_PROVIDER=groq

# Provider-native model id. Free-tier ids are retired without notice; verify
# against the provider's live model list before deploying.
#
# Known working (verified 2026-08-07):
#   groq   llama-3.3-70b-versatile   non-reasoning, good at structured JSON
#
# Avoid reasoning models unless MAX_TOKENS is also raised substantially: hidden
# reasoning is drawn from the same output budget as the visible reply.
MODEL_NAME=llama-3.3-70b-versatile

# Clustering complaints from supplied review text, not open-ended authoring.
MODEL_TEMPERATURE=0.2

# Output cap for the single gap-analysis call. 2-6 gaps with a description each
# needs roughly 800-1200 tokens.
MAX_TOKENS=2000

MODEL_TIMEOUT_SECONDS=60

# The provider's key. Which one is needed depends on MODEL_PROVIDER above; with
# the default (groq) it is this one. https://console.groq.com
GROQ_API_KEY=

# --------------------------------------------------------------------------- #
# App Store (iOS)
# --------------------------------------------------------------------------- #

# Storefront for both app lookup and the review feed. Fixed to "us" and not
# offered as a UI choice: as of 2026-08-07, Apple's public customer-reviews
# feed only reliably serves the US storefront — every other country code
# tested returns an empty response (see docs/01-prd.md §7). Kept as a setting
# rather than a constant so a future fix to Apple's endpoint is a config
# change, not a code change.
APPSTORE_COUNTRY=us

# Ceiling on reviews used from one fetch, both platforms. Apple's feed serves
# roughly 50 most-recent reviews per request, and pagination (`page=N`) is
# currently broken — confirmed by direct testing, not assumed — so this trims
# the response rather than driving a page loop. Google Play's feed supports a
# larger single fetch, but this cap keeps the two platforms' sample sizes
# comparable and the gap-analysis prompt cost predictable.
MAX_REVIEWS=50

# Floor on ≤3★ reviews in the sample before a gap analysis is attempted. Below
# this, the report shows the rating snapshot only, with an explicit "not
# enough signal" message instead of a synthesis call.
MIN_CRITICAL_REVIEWS=5

# Per-call timeout for the App Store HTTP calls (lookup and review feed).
REQUEST_TIMEOUT_SECONDS=15

# --------------------------------------------------------------------------- #
# Google Play (Android)
# --------------------------------------------------------------------------- #

# Default storefront offered in the UI's Android country picker. Unlike
# APPSTORE_COUNTRY, this is a real, working choice: 12 storefronts (us, gb,
# in, ca, au, de, fr, br, jp, mx, id, ng — see ui/input_form.py) were each
# confirmed by direct testing (docs/01-prd.md § Addendum), and Play's own
# review system is properly localized per storefront, unlike Apple's feed.
PLAYSTORE_COUNTRY=us

# --------------------------------------------------------------------------- #
# Budgets
# --------------------------------------------------------------------------- #

# Per-review trim handed to the model, on a word boundary.
REVIEW_CHAR_CAP=900

# Total characters of review text in the one gap-analysis prompt.
EVIDENCE_CHAR_BUDGET=14000

# --------------------------------------------------------------------------- #
# Guardrails
# --------------------------------------------------------------------------- #

# Master switch for input scanning and output sanitising. The prompt fence
# around review text is NOT covered by this and is always applied.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding in the app-search query stops the run or only
# warns. Turn off if a false positive gets in the way of a demo.
BLOCK_FLAGGED_INPUT=true

LOG_LEVEL=INFO
