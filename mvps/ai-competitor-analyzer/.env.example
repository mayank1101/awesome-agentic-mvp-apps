# AI Competitor Analyzer — configuration
#
# Copy to `.env` and fill in the two keys. On Streamlit Community Cloud there is
# no `.env`: put the same names into Settings → Secrets, and `streamlit_app.py`
# copies them into the environment before anything reads them. A real
# environment variable always wins over a secrets entry.
#
# Every value below is a default that the app already uses. Set one only to
# change it.

# --------------------------------------------------------------------------- #
# Required
# --------------------------------------------------------------------------- #

# Tavily search. Free tier is 1,000 credits per month, no card:
# https://tavily.com — one report costs 6-8 credits, so roughly 125 reports.
TAVILY_API_KEY=

# The model provider's key. Which one is needed depends on MODEL_PROVIDER below;
# with the default (groq) it is this one. https://console.groq.com
GROQ_API_KEY=

# There is deliberately no partial mode. Search without synthesis is a list of
# links, and synthesis without search is the unsourced chatbot this app exists
# to replace, so a missing key stops the app at startup with a named error.

# --------------------------------------------------------------------------- #
# Model
# --------------------------------------------------------------------------- #

# openrouter | groq | openai | anthropic | ollama | gemini | foundry
MODEL_PROVIDER=groq

# Provider-native model id.
#
# Free-tier ids are retired without notice, and the app cannot detect that at
# startup without spending a call, so it reports the rejection at run time with
# the id named. Verify against the provider's live model list before deploying.
#
# Known working (verified 2026-08-04):
#   groq        llama-3.3-70b-versatile     non-reasoning, 12k TPM, 100k tokens/day
#               llama-3.1-8b-instant        faster, weaker, 6k TPM
#   openrouter  google/gemma-4-26b-a4b-it:free      supports structured output
#               inclusionai/ling-3.0-flash:free     no structured-output mode;
#                                                   the app degrades to asking
#                                                   for JSON in prose and still
#                                                   works
#
# Avoid reasoning models unless you also raise MAX_TOKENS substantially: hidden
# reasoning is drawn from the same output budget, so the allowance can be spent
# before any JSON is emitted. `openai/gpt-oss-120b` fails this way at the
# default cap.
MODEL_NAME=llama-3.3-70b-versatile

# Extraction from retrieved text, not authoring, so this is lower than the
# other apps in this repo.
MODEL_TEMPERATURE=0.2

# Output cap for the single synthesis call. Six sections of prose need roughly
# 1,500 tokens. Kept low on purpose: Groq counts this *reservation* toward its
# per-minute token limit whether or not the model writes that much, and a 4096
# cap plus this app's evidence exceeded an 8k TPM ceiling and failed every
# request before a word was written.
MAX_TOKENS=2500

# Per-call timeout on the synthesis request.
MODEL_TIMEOUT_SECONDS=60

# --------------------------------------------------------------------------- #
# Search
# --------------------------------------------------------------------------- #

# basic costs 1 credit per search, advanced costs 2. The whole budget is sized
# around basic.
SEARCH_DEPTH=basic

# A timed-out search becomes an empty section, never a failed report.
SEARCH_TIMEOUT_SECONDS=20

# The app's cap on its own spending, per report: six section searches, plus one
# optional resolution search when no domain is given, plus one optional pricing
# retry against the company's own site. Checked before every call, never after.
MAX_SEARCH_CREDITS_PER_REPORT=8

MAX_RESULTS_PER_SECTION=5
# More are requested for recent moves because undated items are dropped later,
# so some of what comes back is expected not to survive.
MAX_RESULTS_RECENT_MOVES=8

# --------------------------------------------------------------------------- #
# Budgets
# --------------------------------------------------------------------------- #

# Global cap on one report. Deliberately above the 90s target: this is the
# guarantee, not the goal. When it expires, the remaining sections are left
# empty and the brief is still written and rendered.
RUN_DEADLINE_SECONDS=120

# Total characters of retrieved text handed to the model. Sized against
# free-tier *rate* limits, not the context window — the window is 131k tokens
# and the binding constraints are per-minute and per-day token budgets.
EVIDENCE_CHAR_BUDGET=12000

# Per-snippet trim, applied on a word boundary.
SNIPPET_CHAR_CAP=1200

# Longer names are truncated with a notice rather than rejected.
MAX_COMPANY_NAME_CHARS=120

# --------------------------------------------------------------------------- #
# Session
# --------------------------------------------------------------------------- #

# How long a search result stays reusable. Streamlit reruns the whole script on
# every interaction, so this is what stops a click mid-run from re-spending
# credits. A cache miss is a cost problem, never a correctness one.
SEARCH_CACHE_TTL_SECONDS=3600

# Cost speed bump for a public deployment, not a security control: reloading the
# page resets it, and the UI says so. Set to 0 to disable.
MAX_REPORTS_PER_SESSION=5

# --------------------------------------------------------------------------- #
# Guardrails
# --------------------------------------------------------------------------- #

# Master switch for input scanning and output sanitising. The prompt fence is
# NOT covered by this and is always applied — it costs nothing and is the layer
# worth trusting, because it does not depend on recognising the attack.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding in the company name stops the run or only
# warns. Turn off if a false positive gets in the way of a demo.
BLOCK_FLAGGED_INPUT=true

LOG_LEVEL=INFO
