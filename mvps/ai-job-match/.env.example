# Copy to `.env` and fill in. On Streamlit Community Cloud there is no `.env`:
# paste the same keys into the app's Secrets, and `streamlit_app.py` bridges them
# into the environment before the first settings read.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Groq API key. Free tier at https://console.groq.com. Every model call in this
# app goes here; without it the app shows a setup screen and does nothing.
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Optional but recommended
# ---------------------------------------------------------------------------

# Mistral API key, used only for `mistral-embed`. Free tier at
# https://console.mistral.ai.
#
# Without it the app still runs: requirement matching falls back to word overlap
# and the report says so on screen. The difference is real -- lexical matching
# scores "shipped services in Golang" as a miss against "Go experience", because
# the words genuinely do not overlap. Set it if you want the score to mean
# something.
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Groq model id. Free-tier ids get retired without notice, so verify against
# https://console.groq.com/docs/models if calls start returning "model not found".
# Known-working alternatives at the time of writing:
#   llama-3.3-70b-versatile   (default: strongest instruction-following here)
#   llama-3.1-8b-instant      (much faster and cheaper; weaker at strict JSON)
#   openai/gpt-oss-120b       (good extraction quality, slower)
#
# Use an INSTRUCT model, not a reasoning one. Reasoning tokens come out of the
# same budget as the visible reply, so a reasoning model with these token caps
# can spend the whole allowance thinking and return an empty string -- which
# looks exactly like a broken app.
MODEL_NAME=llama-3.3-70b-versatile

# Low because every call is extraction or constrained rewriting, never authoring.
# Raising this makes the rewrite more fluent and more likely to invent, which the
# fabrication guard will then reject.
MODEL_TEMPERATURE=0.2

# Output caps, per call type. The rewrite needs the largest because it emits a
# whole resume. Groq counts the *reservation* toward its per-minute token limit,
# so these are sized to fit a free-tier key rather than set generously.
MAX_TOKENS_EXTRACTION=2600
MAX_TOKENS_ASSESSMENT=2200
MAX_TOKENS_TAILOR=3200

# Per-call timeout. A whole analysis is three calls, so this is not the ceiling
# on a run -- RUN_DEADLINE_SECONDS is.
MODEL_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

EMBEDDING_MODEL=mistral-embed
EMBEDDING_TIMEOUT_SECONDS=30
# Texts per request. Mistral's free tier limits requests more tightly than
# tokens, so batching is the cheap win.
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Input limits
# ---------------------------------------------------------------------------

# Caps on what reaches a model. A resume past this is truncated on a line
# boundary, with a notice on screen -- never mid-bullet, because half a bullet is
# something the model will complete from imagination.
MAX_RESUME_CHARS=20000
MAX_JD_CHARS=12000

# Below this many characters of extracted text, the PDF is treated as a scan.
# There is no OCR in this app; it would need a system binary or a vision model,
# and neither fits the deployment target.
MIN_RESUME_CHARS=200

MAX_RESUME_PAGES=8
MAX_UPLOAD_BYTES=5242880

# Cap on requirements extracted from one posting. Every requirement costs prompt
# tokens in the assessment call, and postings with 40 bullet points are usually
# 40 restatements of 12 things.
MAX_REQUIREMENTS=25

# Whole-run ceiling, checked between steps.
RUN_DEADLINE_SECONDS=240

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Master switch for input scanning and output sanitising. The prompt fence is NOT
# covered by this and is always applied -- it costs nothing and is the layer worth
# trusting.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding stops the run or only warns. Both documents are
# untrusted here: a posting is pasted from a web page, and a resume can carry
# white-on-white text telling the grader what to conclude.
BLOCK_FLAGGED_INPUT=true

# Whether a rewrite that states a fact absent from the original resume is refused
# outright (true) or shown with the offending fragments flagged (false).
#
# True by default. An invented employer on a real person's resume follows them
# into an interview they cannot answer questions in; a refusal costs them one
# click. Set false only when you want to inspect what the guard caught.
STRICT_FABRICATION_GUARD=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG for development. Nothing logs resume text at any level, and the handler
# redacts credentials, emails, and phone numbers regardless.
LOG_LEVEL=INFO
