# Copy to `.env` and fill in. On Streamlit Community Cloud there is no `.env`:
# paste the same keys into the app's Secrets, and `streamlit_app.py` bridges them
# into the environment before the first settings read.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Tavily API key. Free tier at https://tavily.com. This is the only way this app
# reaches the web: every search and every posting fetch goes through it, and
# there is no scraper and no headless browser anywhere in the codebase.
#
# Free-tier credits are a MONTHLY pool, not a per-minute rate. One run spends
# roughly (queries + 1) credits: one per search query, plus one extract call for
# the batch of postings that get read in full.
TAVILY_API_KEY=tvly-your_key_here

# Groq API key. Free tier at https://console.groq.com. Reads the resume once per
# run, then judges one posting per deeply-scored job.
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Optional but recommended
# ---------------------------------------------------------------------------

# Mistral API key, used only for `mistral-embed`. Free tier at
# https://console.mistral.ai.
#
# Without it the app still runs: ranking and evidence matching fall back to word
# overlap and the screen says so. The difference is real -- lexical matching
# scores "shipped services in Golang" as a miss against "Go experience", because
# the words genuinely do not overlap.
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Groq model id. Free-tier ids get retired without notice, so verify against
# https://console.groq.com/docs/models if calls start returning "model not found".
# Known-working alternatives at the time of writing:
#   llama-3.3-70b-versatile   (default: strongest instruction-following here)
#   llama-3.1-8b-instant      (much faster and cheaper; weaker at strict JSON)
#   openai/gpt-oss-120b       (good extraction quality, slower)
#
# Use an INSTRUCT model, not a reasoning one. Reasoning tokens come out of the
# same budget as the visible reply, so a reasoning model with these token caps
# can spend the whole allowance thinking and return an empty string -- which
# looks exactly like a broken app.
MODEL_NAME=llama-3.3-70b-versatile

# Low because every call is extraction or judgement against supplied text, never
# authoring. Raising it makes the model more willing to credit a requirement the
# resume does not evidence.
MODEL_TEMPERATURE=0.2

# Output caps, per call type. The assessment call emits every requirement plus a
# verdict and an evidence quote for each, so it needs the larger reservation.
# Groq counts the *reservation* toward its per-minute token limit, so these are
# sized to fit a free-tier key rather than set generously.
MAX_TOKENS_PROFILE=1800
MAX_TOKENS_ASSESSMENT=2600

# Per-call timeout. A whole run is one profile call plus one call per deeply
# scored job, so this is not the ceiling on a run -- RUN_DEADLINE_SECONDS is.
MODEL_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

# `basic` or `advanced`. Advanced costs more credits and returns better
# snippets. Basic is the default because snippets here only have to *rank*: the
# jobs that get scored have their full page fetched anyway.
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=45

# Results requested per query, and how many distinct queries one run issues.
# Every query is a credit, and past a handful they return the same postings from
# different angles.
RESULTS_PER_QUERY=10
MAX_QUERIES=4

# Cap on results carried forward after de-duplication.
MAX_RESULTS_TOTAL=40

# URLs per extract request. Tavily accepts up to 20; batching is what keeps a run
# to one or two extract credits.
EXTRACT_BATCH_SIZE=10

# How many top-ranked jobs are read in full and scored requirement by
# requirement. The single most expensive knob in the app: each one is a page
# fetch plus a model call. Raising it to 20 gives better answers and a run that
# can exhaust a free-tier daily token budget by itself.
DEEP_SCORE_COUNT=8

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

EMBEDDING_MODEL=mistral-embed
EMBEDDING_TIMEOUT_SECONDS=30
# Texts per request. Mistral's free tier limits requests more tightly than
# tokens, so batching is the cheap win.
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Input limits
# ---------------------------------------------------------------------------

# Caps on what reaches a model. A resume past this is truncated on a line
# boundary, with a notice on screen -- never mid-bullet, because half a bullet is
# something the model will complete from imagination.
MAX_RESUME_CHARS=20000

# Below this many characters of extracted text, the PDF is treated as a scan.
# There is no OCR in this app; it would need a system binary or a vision model,
# and neither fits the deployment target.
MIN_RESUME_CHARS=200

MAX_RESUME_PAGES=8
MAX_UPLOAD_BYTES=5242880

# Cap on one fetched posting. Careers pages carry benefits copy, EEO statements,
# and company history; the requirements are almost always near the top.
MAX_POSTING_CHARS=12000

# Below this, a fetched page is treated as a JavaScript shell, a login wall, or a
# closed listing. The job then keeps its snippet-based score and the row says so.
MIN_POSTING_CHARS=400

# Cap on requirements taken from one posting. A posting with 40 bullets is
# usually 40 restatements of 12 things.
MAX_REQUIREMENTS=20

# Whole-run ceiling, checked between steps. A run that hits it returns what it
# has scored so far, with the rest ranked rather than dropped.
RUN_DEADLINE_SECONDS=300

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Master switch for input scanning. The prompt fence is NOT covered by this and
# is always applied -- it costs nothing and is the layer worth trusting.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding in the RESUME stops the run or only warns.
# Fetched postings are never blocked on, whatever this is set to: the user did
# not write them, and hiding a job because its page contains an odd sentence
# hides a job the user might want. The fence is what contains those.
BLOCK_FLAGGED_INPUT=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG for development. Nothing logs resume text at any level, and the handler
# redacts credentials, emails, and phone numbers regardless.
LOG_LEVEL=INFO
