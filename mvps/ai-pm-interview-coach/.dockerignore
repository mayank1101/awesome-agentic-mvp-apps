# Keep the build context small and, more importantly, keep secrets out of the
# image: .env would otherwise be COPYed in and shipped to the registry.
.env
*.env
!.env.example

.venv/
venv/
env/
ENV/

__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

.git/
.gitignore
.github/
.claude/
.vscode/
.idea/

*.md
!README.md

Dockerfile
.dockerignore
requirements-dev.txt
tests/

.DS_Store
*.log
