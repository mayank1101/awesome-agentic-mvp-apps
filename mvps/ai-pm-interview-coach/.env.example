# Which client backs the agents. Only the credentials for the one you pick matter.
#   openrouter | groq | openai | anthropic | ollama | gemini | foundry
MODEL_PROVIDER=groq

# Provider-native model id. For foundry, this is the deployment name.
# Groq model id, e.g. llama-3.3-70b-versatile, openai/gpt-oss-20b, openai/gpt-oss-120b
MODEL_NAME=llama-3.3-70b-versatile
MODEL_TEMPERATURE=0.4
MAX_TOKENS=4096

# How the report step asks for JSON:
#   json_object  - ask for valid JSON, shape described in the instructions
#                  (default, widest model support)
#   json_schema  - provider-enforced FeedbackReport schema; only some models accept it
#   prompt       - send no response_format at all
# Providers that cannot honour the chosen mode degrade to "prompt" on their own.
STRUCTURED_OUTPUT_MODE=json_object

LOG_LEVEL=INFO

# --- interview shape -------------------------------------------------------
# A question is a question. The document-wide MAX_TOKENS would let a chatty
# model deliver a lecture, which breaks the "one question, no coaching" rules.
#
# RAISE THIS on a reasoning model (gpt-oss, the nemotron and o-series families).
# Reasoning tokens are drawn from the same budget as the reply, so a small cap can
# be consumed entirely before any question is emitted -- which the app then
# correctly reports as an empty question. 2048 is a safe floor there.
INTERVIEWER_MAX_TOKENS=512
# The graded report is the long output.
REPORT_MAX_TOKENS=4096
# Per-answer cap. Load-bearing, not cosmetic: the full conversation is resent on
# every turn, so an uncapped answer is multiplied across the remaining turns and
# can overflow the context window of exactly the free-tier models above.
MAX_ANSWER_CHARS=4000
# Below this the UI notes that short answers score low. Never blocks a submit.
MIN_ANSWER_HINT_CHARS=100

# --- session lifecycle -----------------------------------------------------
# Bounds every streamed call, so an abandoned stream cannot leave the interview
# screen waiting forever. There is no session timeout: the conversation lives in
# Streamlit's session state and goes away with the browser session.
STREAM_TIMEOUT_SECONDS=90

# --- guardrails ------------------------------------------------------------
# GUARDRAILS_ENABLED covers input scanning and output sanitising. The prompt
# fence around candidate answers is always applied and is not affected by this.
GUARDRAILS_ENABLED=true
# Whether a high-severity injection finding blocks the turn or only warns.
BLOCK_FLAGGED_INPUT=true

# --- cost guard ------------------------------------------------------------
# Interviews per browser session, 0 to disable. Not a security control: a page
# reload starts a new session, and a container restart resets the counter.
MAX_INTERVIEWS_PER_SESSION=5

# --- openrouter -------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- groq ---------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- openai / anthropic -----------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ollama -----------------------------------------------------------------
# No key: reachability is the only gate. From inside Docker, localhost is the
# container, so use http://host.docker.internal:11434 to reach the host.
OLLAMA_HOST=http://localhost:11434

# --- gemini (Google AI Studio) ----------------------------------------------
GEMINI_API_KEY=

# --- foundry (Azure AI Foundry) ---------------------------------------------
# Authenticates with DefaultAzureCredential, not an API key. In a container the
# only path that works is a service principal, so we need to set AZURE_CLIENT_ID,
# AZURE_TENANT_ID and AZURE_CLIENT_SECRET alongside the endpoint.
AZURE_AI_PROJECT_ENDPOINT=
