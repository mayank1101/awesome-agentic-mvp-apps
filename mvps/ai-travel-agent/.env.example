# Copy to `.env` and fill in. On Streamlit Community Cloud there is no `.env`:
# paste the same keys into the app's Secrets, and `streamlit_app.py` bridges them
# into the environment before the first settings read.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Groq API key. Free tier at https://console.groq.com. The itinerary-writing
# call goes here; without it the app shows a setup screen and does nothing.
GROQ_API_KEY=gsk_your_key_here

# Tavily API key. Free tier at https://tavily.com. The only path this app has
# to the web -- without it there is nothing to ground the itinerary in.
TAVILY_API_KEY=tvly-your_key_here

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Groq model id. Free-tier ids get retired without notice, so verify against
# https://console.groq.com/docs/models if calls start returning "model not found".
# Use an INSTRUCT model, not a reasoning one -- reasoning tokens come out of the
# same budget as the visible reply.
MODEL_NAME=llama-3.3-70b-versatile

# A little higher than a pure-extraction app's: sequencing a day and writing
# the connective prose between stops is a light creative task.
MODEL_TEMPERATURE=0.3

# Output cap for the single synthesis call, sized for the longest trip this
# app allows (MAX_DAYS), not the typical one.
MAX_TOKENS_ITINERARY=4000

MODEL_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

# basic or advanced. Basic is enough here -- unlike a factual company brief,
# these snippets only have to describe a place well enough to plan a day
# around, not stand as the sole evidence for a claim.
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=45

RESULTS_PER_QUERY=8

# Cap on how many searches one trip issues. Query count already scales with
# trip length (see app/services/search.py); this is a ceiling on top of that.
MAX_QUERIES=6

# Cap on deduplicated results per category (activities, accommodation, tips)
# that reach the prompt.
MAX_EVIDENCE_PER_CATEGORY=8

# Cap on one search result's snippet, when building the evidence the model reads.
MAX_SNIPPET_CHARS=600

# ---------------------------------------------------------------------------
# Trip budgets
# ---------------------------------------------------------------------------

MIN_DAYS=1
MAX_DAYS=14
MAX_DESTINATION_CHARS=100
MAX_INTERESTS_CHARS=300

# Whole-run ceiling, checked between steps.
RUN_DEADLINE_SECONDS=180

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Master switch for the heuristic prompt-injection scan over the destination
# and interests fields.
GUARDRAILS_ENABLED=true

# Whether a high-severity finding stops the run (true) or only logs (false).
BLOCK_FLAGGED_INPUT=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
