# Which client backs the estimator. Only the credentials for the one you pick matter.
#   openrouter | groq | openai | anthropic | ollama | gemini | foundry
MODEL_PROVIDER=groq

# Provider-native model id. For foundry, this is the deployment name.
# Groq model id, e.g. llama-3.3-70b-versatile, openai/gpt-oss-20b, openai/gpt-oss-120b
MODEL_NAME=llama-3.3-70b-versatile

# Low on purpose. The estimator's job is classifying prose onto fixed scales;
# a creative reading of "Impact: 2" has no upside, and run-to-run drift in the
# factors would move the ranking for no reason a user could explain.
MODEL_TEMPERATURE=0.2

# Sized for a whole backlog, not one answer. Each feature costs roughly 120
# tokens of JSON, so a 25-item list needs several thousand. Too low and the
# reply is truncated mid-list, which loses features rather than failing loudly.
MAX_TOKENS=8192

# How the estimator asks for JSON:
#   json_object  - ask for valid JSON, shape described in the instructions
#                  (default, widest model support)
#   json_schema  - provider-enforced BacklogEstimate schema; only some models accept it
#   prompt       - send no response_format at all
# Providers that cannot honour the chosen mode degrade to "prompt" on their own.
STRUCTURED_OUTPUT_MODE=json_object

LOG_LEVEL=INFO

# --- backlog limits ---------------------------------------------------------
# The whole backlog is estimated in ONE call, so the features are calibrated
# against each other rather than scored in isolation. That is what makes the
# ranking mean anything -- and it is what makes list length a token-budget
# question. Raise MAX_FEATURES only alongside MAX_TOKENS.
MAX_FEATURES=25
# Per-feature cap on title plus notes. Long notes do not improve the estimate;
# they crowd out the other features in the same call.
MAX_FEATURE_CHARS=400
# Cap on the product-context box. Two lines is what it is for.
MAX_CONTEXT_CHARS=600

# --- guardrails -------------------------------------------------------------
# GUARDRAILS_ENABLED covers input scanning and output sanitising. The prompt
# fence around the backlog is always applied and is not affected by this.
GUARDRAILS_ENABLED=true
# Whether a high-severity injection finding blocks estimation or only warns.
BLOCK_FLAGGED_INPUT=true
# Cost guard for public deployments: estimation calls per browser session, 0 to
# disable. Not a security control -- a page reload starts a new session.
# Editing factors never counts against this, because editing never calls a model.
MAX_ESTIMATIONS_PER_SESSION=20

# --- openrouter -------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- groq -------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- openai / anthropic -----------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ollama -----------------------------------------------------------------
# No key: reachability is the only gate. From inside Docker, localhost is the
# container, so use http://host.docker.internal:11434 to reach the host.
OLLAMA_HOST=http://localhost:11434

# --- gemini (Google AI Studio) ----------------------------------------------
GEMINI_API_KEY=

# --- foundry (Azure AI Foundry) ---------------------------------------------
# Authenticates with DefaultAzureCredential, not an API key. In a container the
# only path that works is a service principal, so set AZURE_CLIENT_ID,
# AZURE_TENANT_ID and AZURE_CLIENT_SECRET alongside the endpoint.
AZURE_AI_PROJECT_ENDPOINT=
